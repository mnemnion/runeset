    .dependencies = .{
        .ztap = .{
            .url = "https://github.com/mnemnion/ztap/archive/refs/tags/v0.9.3.tar.gz",
            .hash = "ztap-0.9.2-2runTdAvAACKFozXPgi5CeMV2o9p7_EAIyAd-lDXh0gU",
        },
    },

    .paths = .{
        ".gitignore",
        "build.zig",
        "build.zig.zon",
        "src",
        "docs",
        "img",
        "LICENSE.md",
        "README.md",
    },
}
