.{
    .name = .runeset,
    // This is a [Semantic Version](https://semver.org/).
    // In a future version of Zig it will be used for package deduplication.
    .version = "0.10.0",

    .minimum_zig_version = "0.16.0",

    // What does this do, he wondered, putting it in all his libraries
    .fingerprint = 0x8edbb0dd5d839f5d,

    .dependencies = .{
        .ztap = .{
            .url = "https://github.com/mnemnion/ztap/archive/refs/tags/v0.9.6.tar.gz",
            .hash = "ztap-0.9.6-2runTcJZAAAGbmsi7tkHaVGweQCg2LncF_LSsAnvAMvs",
        },
    },

    .paths = .{
        ".gitignore",
        "build.zig",
        "build.zig.zon",
        "src",
        "docs",
        "img",
        "LICENSE.md",
        "README.md",
    },
}
